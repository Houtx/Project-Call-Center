API_IMAGE=project-call-center-api:0.6.1
WEB_IMAGE=project-call-center-web:0.6.1
API_LOOPBACK_PORT=18800
WEB_LOOPBACK_PORT=18801

POSTGRES_DB=call_center
POSTGRES_USER=call_center
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode special characters in the password below.
DATABASE_URL=postgresql://call_center:replace-with-url-encoded-password@postgres:5432/call_center?schema=public&connection_limit=10&pool_timeout=10

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30
PHONE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
PHONE_HASH_KEY=replace-with-another-base64-encoded-32-byte-key
WEB_ORIGIN=https://call.example.com
RECORDINGS_DIR=/var/lib/project-call-center/recordings
RECORDING_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Low-resource defaults. Raise a limit only after observing container peaks on the target host.
API_MEMORY_LIMIT=512m
API_CPU_LIMIT=1.0
API_PIDS_LIMIT=128
API_NODE_OPTIONS=--max-old-space-size=384
WEB_MEMORY_LIMIT=64m
WEB_CPU_LIMIT=0.25
WEB_PIDS_LIMIT=64
POSTGRES_MEMORY_LIMIT=512m
POSTGRES_CPU_LIMIT=1.0
POSTGRES_PIDS_LIMIT=128
WORKER_MEMORY_LIMIT=256m
WORKER_CPU_LIMIT=0.5
WORKER_PIDS_LIMIT=96
WORKER_NODE_OPTIONS=--max-old-space-size=160
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3

# The API runs reconciliation internally by default, avoiding a second resident Node.js process.
# To use the optional dedicated-worker profile, set this to false on the API service and follow deploy/README.md.
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_RECONCILIATION_INTERVAL_MS=60000
BACKGROUND_HOUSEKEEPING_INTERVAL_MS=3600000
TECHNICAL_DATA_RETENTION_DAYS=7
HOUSEKEEPING_BATCH_SIZE=5000
IMPORT_MAX_ROWS=10000
BULK_ASSIGNMENT_MAX_QUANTITY=10000
BULK_ASSIGNMENT_SCAN_MAX_ROWS=100000

# Conservative PostgreSQL starting values for a small shared server.
POSTGRES_MAX_CONNECTIONS=40
POSTGRES_SHARED_BUFFERS=96MB
POSTGRES_EFFECTIVE_CACHE_SIZE=256MB
POSTGRES_WORK_MEM=2MB
POSTGRES_MAINTENANCE_WORK_MEM=32MB
POSTGRES_AUTOVACUUM_WORK_MEM=32MB
POSTGRES_CHECKPOINT_TIMEOUT=15min
POSTGRES_MAX_WAL_SIZE=512MB
POSTGRES_MIN_WAL_SIZE=80MB

# Set only while running the one-time bootstrap-admin command, then remove it.
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=系统管理员
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-12-character-or-longer-password

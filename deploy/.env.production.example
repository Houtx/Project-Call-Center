API_IMAGE=project-call-center-api:0.3.0
WEB_IMAGE=project-call-center-web:0.3.0
API_LOOPBACK_PORT=18800
WEB_LOOPBACK_PORT=18801

POSTGRES_DB=call_center
POSTGRES_USER=call_center
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode special characters in the password below.
DATABASE_URL=postgresql://call_center:replace-with-url-encoded-password@postgres:5432/call_center?schema=public

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30
PHONE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
PHONE_HASH_KEY=replace-with-another-base64-encoded-32-byte-key
WEB_ORIGIN=https://call.example.com
RECORDINGS_DIR=/var/lib/project-call-center/recordings
RECORDING_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Set only while running the one-time bootstrap-admin command, then remove it.
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=系统管理员
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-12-character-or-longer-password

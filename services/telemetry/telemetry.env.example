TELEMETRY_BIND_HOST=127.0.0.1
TELEMETRY_BIND_PORT=18820
TELEMETRY_DATABASE_PATH=/var/lib/project-call-center-telemetry/telemetry.sqlite3
TELEMETRY_STATIC_DIR=/opt/project-call-center-telemetry/current/static
TELEMETRY_ADMIN_USERNAME=admin
TELEMETRY_ADMIN_PASSWORD_HASH=replace-with-pbkdf2-hash
TELEMETRY_SESSION_SECRET=replace-with-at-least-32-random-bytes
TELEMETRY_IDENTIFIER_SECRET=replace-with-a-different-random-secret
TELEMETRY_DETAIL_RETENTION_DAYS=30
TELEMETRY_SECURE_COOKIE=true

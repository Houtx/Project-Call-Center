NODE_ENV=development
API_PORT=8800
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://call_center:call_center_dev@localhost:54329/call_center?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
# Generate each phone key with: openssl rand -base64 32
PHONE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
PHONE_HASH_KEY=replace-with-another-base64-encoded-32-byte-key
ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-local-admin-password-of-at-least-12-characters
SEED_AGENT_PASSWORD=replace-with-a-local-agent-password-of-at-least-12-characters
TZ=Asia/Shanghai

# Web build-time API location
VITE_API_BASE_URL=http://localhost:8800/api/v1
VITE_API_PROXY_TARGET=http://localhost:8800
